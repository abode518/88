PORT=9100
COMFY_URL=http://127.0.0.1:8188

# مسار ملف الـ workflow بصيغة API (زر "Save (API Format)" من ComfyUI بعد تفعيل Dev Mode)
WORKFLOW_PATH=./workflow.json

# رقم عنصر (node id) في الـ workflow اللي فيه برومبت النص الإيجابي (CLIPTextEncode أو ما يشابهه)
PROMPT_NODE_ID=6
# اسم الحقل داخل inputs لذاك العنصر (غالباً "text")
PROMPT_FIELD=text

# اختياري: عنصر فيه عدد الفريمات/الطول (لو موجود بالـ workflow)، يُستخدم لترجمة duration (ثواني) لو حطيت FPS
FRAMES_NODE_ID=
FRAMES_FIELD=
FRAMES_PER_SECOND=8
