# السيرفر
PORT=3000
SESSION_SECRET=change_me

# === محرك الشات (أي نقطة نهاية متوافقة مع OpenAI /chat/completions) ===
# ضع هنا رابط موديل غير مقيّد تشغّله بنفسك أو تدفع له (local llama.cpp server, vLLM, Ollama+openai-shim, أي مزود تختاره)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=FILL_ME
LLM_MODEL=FILL_ME

# === محرك الصور ===
# IMAGE_API_MODE = sdwebui | openai
# sdwebui: أي سيرفر Stable Diffusion WebUI / ComfyUI عليه endpoint متوافق مع /sdapi/v1/txt2img
# openai: أي نقطة نهاية متوافقة مع /images/generations
IMAGE_API_MODE=sdwebui
IMAGE_BASE_URL=http://localhost:7860
IMAGE_API_KEY=FILL_ME

# === محرك الفيديو ===
# أي خدمة توفر: POST {base}/generate -> {job_id}  و GET {base}/status/{job_id} -> {status, video_url}
VIDEO_BASE_URL=http://localhost:9000
VIDEO_API_KEY=FILL_ME
